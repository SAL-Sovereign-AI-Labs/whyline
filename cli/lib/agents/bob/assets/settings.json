{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .bob/hooks/whyline.sh session-start --agent bob",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .bob/hooks/whyline.sh capture --agent bob",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(write_file|write_to_file|apply_diff|insert_content|search_and_replace)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh .bob/hooks/whyline.sh capture --agent bob",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^execute_command$",
        "hooks": [
          {
            "type": "command",
            "command": "sh .bob/hooks/whyline-guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
